# Copy to .env.production and fill in with `terraform output` values before
# running `npm run build` — see scripts/deploy-frontend.sh, which does this
# automatically from the Terraform state instead of requiring manual
# copy-pasting.

# Custom domain, root output: api_url (build step 19). Before step 19
# applied, use api_gateway_endpoint instead (the default execute-api.*
# URL) — both work, the custom domain just looks better in demos.
VITE_API_BASE_URL=https://api.shop.stefantimpau.com

# module.cognito.hosted_ui_domain (root output: cognito_hosted_ui_domain)
VITE_COGNITO_DOMAIN=xxxxxxxxxx-dev-auth.auth.eu-west-2.amazoncognito.com

# module.cognito.user_pool_client_id (root output: cognito_user_pool_client_id)
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Must exactly match one of the Cognito app client's callback_urls
# (terraform/environments/dev/main.tf) — the custom domain (root output:
# frontend_url) once step 19 is applied, http://localhost:3000 for local
# dev, or the raw CloudFront domain before step 19.
VITE_COGNITO_REDIRECT_URI=https://shop.stefantimpau.com

# module.static_frontend.cloudfront_domain_name (root output: cloudfront_domain_name)
# — used to build product image URLs (CloudFront /images/* -> the images
# S3 bucket).
VITE_CLOUDFRONT_DOMAIN=xxxxxxxxxx.cloudfront.net
